{
  "name": "hacknation2026-zus",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @zus/engine build && pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter @zus/engine build && pnpm --filter backend dev",
    "build": "pnpm -r build",
    "infra": "docker compose up -d",
    "setup:zusia": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "knowledge:build": ".venv/bin/python -m python.knowledge.build",
    "dev:zusia": ".venv/bin/uvicorn python.main:app --port 8001 --reload"
  }
}
