# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap.xml, robots.txt
# and Open Graph / Twitter tags. Required for production builds.
VITE_SITE_URL=https://zusia.example.pl

# Set to "true" on staging / preview deployments so search engines don't index them
# (robots.txt disallows everything and every page gets <meta name="robots" content="noindex, nofollow">).
VITE_NOINDEX=false
