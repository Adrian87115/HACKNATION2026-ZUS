# Copy to .env.production on the server and fill in. Never commit the real file.
# Server with its own domain: the domain pointing at the server (A record) – Caddy gets the HTTPS certificate.
# Own computer behind a Cloudflare tunnel: DOMAIN=:80 (plain HTTP locally, the tunnel provides HTTPS).
DOMAIN=zusia.example.pl
# Public address of the app (canonical links, sitemap, allowed origin), e.g. https://zusia.example.pl
SITE_URL=https://zusia.example.pl

# OpenAI key for ZUSia (chat, MCP tools, case import)
OPEN_AI_KEY=
# ZUSIA_MODEL=gpt-5.4-mini

# Admin panel token – generate: openssl rand -hex 32
ADMIN_TOKEN=

# Private MinIO credentials – generate the password: openssl rand -hex 24
MINIO_ROOT_USER=zusia
MINIO_ROOT_PASSWORD=
CASE_RETENTION_DAYS=30
