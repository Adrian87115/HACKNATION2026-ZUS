# Copy to .env.production on the server and fill in. Never commit the real file.
# Domain pointing at the VM's public IP (A record) – Caddy gets the HTTPS certificate for it.
DOMAIN=zusia.example.pl

# OpenAI key for ZUSia (chat, MCP tools, case import)
OPEN_AI_KEY=
# ZUSIA_MODEL=gpt-5.4-mini

# Admin panel token – generate: openssl rand -hex 32
ADMIN_TOKEN=

# Private MinIO credentials – generate the password: openssl rand -hex 24
MINIO_ROOT_USER=zusia
MINIO_ROOT_PASSWORD=
CASE_RETENTION_DAYS=30
