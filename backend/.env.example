# Copy to backend/.env

# HTTP port (frontend dev proxy expects 3000)
PORT=3000

# Token for the admin panel (/admin in the frontend). Without it, changing engine parameters is disabled.
# Generate one, e.g.: openssl rand -hex 24
ADMIN_TOKEN=

# Where admin parameter overrides and the change log are stored (default: ./data/engine-params.json)
# ENGINE_PARAMS_FILE=./data/engine-params.json
