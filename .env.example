# Copy to .env and fill in. Used by python/ (ZUSia API) and docker-compose.yml.

# Google Gemini API key for the ZUSia assistant and case import
ZUS_API_KEY=

# Allowed origins for the ZUSia API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- Object storage (MinIO locally: `docker compose up -d`) ------------------------------------
# MinIO root credentials (docker-compose.yml). Change them outside local development.
MINIO_ROOT_USER=zusia
MINIO_ROOT_PASSWORD=zusia-dev-password

# S3 connection used by python/. Leave S3_ENDPOINT_URL empty to run without object storage
# (chat attachments then stay in SQLite and uploaded case documents are not kept).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=zusia
S3_SECRET_KEY=zusia-dev-password
S3_REGION=us-east-1
S3_BUCKET_ATTACHMENTS=zusia-attachments
S3_BUCKET_CASES=zusia-cases
# Case documents are deleted automatically after this many days (bucket lifecycle rule)
CASE_RETENTION_DAYS=30
